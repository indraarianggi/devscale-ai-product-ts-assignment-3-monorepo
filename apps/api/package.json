{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env tsx watch src/index.ts",
    "worker:dev": "pnpm with-env tsx watch src/worker.ts",
    "build": "tsc && tsc-alias -p tsconfig.json --resolve-full-paths",
    "start": "node dist/index.js",
    "db:migrate": "pnpm with-env prisma migrate dev",
    "db:deploy": "pnpm with-env prisma migrate deploy",
    "db:generate": "pnpm with-env prisma generate",
    "db:studio": "pnpm with-env prisma studio",
    "test": "pnpm with-env vitest run",
    "test:watch": "pnpm with-env vitest",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@anvia/core": "^0.26.0",
    "@anvia/openai": "^0.5.1",
    "@anvia/server": "^0.7.6",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/hono-api-reference": "^0.11.14",
    "bullmq": "^6.1.1",
    "hono": "^4.13.2",
    "ioredis": "^6.0.0",
    "marked": "^18.0.9",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pdfkit": "^0.17.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}